{
  "name": "chatserve-client",
  "version": "1.0.0",
  "private": true,
  "description": "ChatServe 桌面客户端外壳 只做窗口与打包 界面代码在 web/",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chatserve.client",
    "productName": "ChatServe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "${productName}.${ext}"
    }
  }
}
